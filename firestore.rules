rules_version = '2';

// =============================================================================
// Ehrenweg — Firestore Güvenlik Kuralları
//
// CLAUDE.md Bölüm 14 ilkeleri:
//   1. Varsayılan HER ŞEY KAPALI, sonra tek tek açılır.
//   2. Yetki custom claim'den okunur (Firestore'daki rol alanı görüntüleme
//      amaçlıdır ve BURADA ASLA kullanılmaz — kullanıcı onu değiştirebilseydi
//      kendini admin yapardı).
//   3. stats / passportEntries / vouchers / ledger / attendanceRecords /
//      bütçe alanları: istemciden YAZMA YOK. Yalnızca Cloud Functions.
//   4. Her kural için rules-unit-testing testi vardır; CI'da testler geçmeden
//      deploy edilmez.
//
// NOT: Cloud Functions Admin SDK bu kuralları HİÇ görmez — onlar için asıl
// koruma functions/src/common/guards.ts içindeki claim kontrolleridir.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Yardımcılar
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    function claims() {
      return request.auth.token;
    }

    function platformRole() {
      return signedIn() ? claims().get('role', 'participant') : 'none';
    }

    function isAdmin() {
      return platformRole() == 'platform_admin';
    }

    /**
     * Eğitmen mi?
     *
     * ⚠️ SAPMA (docs/DECISIONS.md §11) — Faz 2'deki kurum rolü çözümünün
     * aynısı: claim'i yalnız sunucu yazabilir, Blaze kapalı olduğu için
     * sunucu yok. Claim'de `trainer` yoksa `users/{uid}.trainerStatus`
     * alanına düşülüyor. O alanı kullanıcı YAZAMAZ (users update kuralındaki
     * izinli alan listesinde yok), yalnız platform admin yazabilir.
     */
    function isTrainer() {
      return platformRole() == 'trainer' || approvedTrainer(uid());
    }

    function approvedTrainer(userId) {
      let path = /databases/$(database)/documents/users/$(userId);
      return exists(path)
             && get(path).data.get('trainerStatus', 'none') == 'approved';
    }

    // Kurum rolü haritası: { orgId: 'org_admin'|'org_staff'|... }
    function orgs() {
      return claims().get('orgs', {});
    }

    // ---------------------------------------------------------------
    // Kurum rolü: ÖNCE custom claim, yoksa üyelik belgesi.
    //
    // ⚠️ SAPMA (docs/DECISIONS.md §8). CLAUDE.md Bölüm 14 yalnız claim diyor.
    // Claim'i yalnızca Cloud Functions yazabilir; Blaze kapalı olduğu için
    // sunucu yok. Bu yüzden `organizations/{orgId}/members/{uid}` belgesi
    // ikinci kaynak. Güvenlik eşdeğer, çünkü o belgeyi yalnızca:
    //   · mevcut bir org_admin, ya da
    //   · platform_admin, ya da
    //   · kurumu HENÜZ BAŞVURU AŞAMASINDA açan kişi (kendi adına, tek sefer)
    // yazabiliyor. Kullanıcıya dönen bir yetki yükseltme zinciri yok.
    // Claim geldiği gün bu okuma fazladan kalır, zarar vermez.
    // ---------------------------------------------------------------
    function memberRole(orgId) {
      let path = /databases/$(database)/documents/organizations/$(orgId)/members/$(uid());
      return exists(path) ? get(path).data.get('role', 'none') : 'none';
    }

    function orgRole(orgId) {
      // Ternary kısa devre yapar: claim'de varsa üyelik belgesi HİÇ okunmaz.
      return orgs().keys().hasAny([orgId]) ? orgs()[orgId] : memberRole(orgId);
    }

    // Admin her kurumda yetkilidir.
    function inOrg(orgId, allowedRoles) {
      return isAdmin() || (signedIn() && orgRole(orgId) in allowedRoles);
    }

    function orgStaff(orgId) {
      return inOrg(orgId, ['org_admin', 'org_staff']);
    }

    function orgAdmin(orgId) {
      return inOrg(orgId, ['org_admin']);
    }

    // E-posta doğrulanmış mı? (Kayıt sonrası bazı işlemler için şart.)
    function verified() {
      return signedIn() && claims().get('email_verified', false) == true;
    }

    // Güncellemede yalnızca izin verilen alanlara dokunulmuş mu?
    function onlyFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(allowed);
    }

    // Bir alanın değeri hiç değişmemiş mi? (sunucu alanlarını kilitler)
    function unchanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ---------------------------------------------------------------------
    // Seviye eşikleri — CLAUDE.md Bölüm 6 tablosu.
    //
    // ⚠️ app/src/config/scoring.ts `levelFor()` ile AYNI mantık. Ayrılırlarsa
    // istemci bir seviye yazar, kural reddeder ve katılım hiç işlenmez.
    // ---------------------------------------------------------------------
    function allowedLevel(stats) {
      return stats.activitiesCompleted >= 30 && stats.hours >= 120 ? 5
           : stats.activitiesCompleted >= 15 && stats.hours >= 50
             && stats.categoriesCount >= 3 ? 4
           : stats.activitiesCompleted >= 8 && stats.hours >= 20 ? 3
           : stats.activitiesCompleted >= 3 ? 2
           : 1;
    }

    // Katılım puanı yazılırken sayaçlar tam olarak girdi kadar artmalı.
    function awardStatsDelta(before, after, entry) {
      return after.ip == before.ip + entry.ipAwarded
             && after.hours == before.hours + entry.hours
             && after.activitiesCompleted == before.activitiesCompleted + 1
             && after.categoriesCount >= before.categoriesCount
             && after.categoriesCount <= before.categoriesCount + 1
             && after.noShows == before.noShows
             // Katılım gerçekleşti → no-show serisi sıfırlanır (Bölüm 6).
             && after.consecutiveNoShows == 0
             && after.level >= 1
             && after.level <= allowedLevel(after);
    }

    // No-show: yalnız sayaçlar artar, puan ASLA artmaz ve eksiye düşmez.
    function noShowStatsDelta(before, after) {
      return after.noShows == before.noShows + 1
             && after.consecutiveNoShows == before.consecutiveNoShows + 1
             && after.activitiesCompleted == before.activitiesCompleted
             && after.hours == before.hours
             && after.categoriesCount == before.categoriesCount
             && after.level == before.level
             && after.ip >= 0
             && after.ip <= before.ip;
    }

    // Başvuru kısıtı sürüyor mu? (CLAUDE.md Bölüm 6: 3 ardışık no-show →
    // 14 gün). Damga `request.time` ile yazıldığı için uydurulamaz.
    function notRestricted(userId) {
      let path = /databases/$(database)/documents/users/$(userId);
      let user = get(path).data;
      return !(user.stats.get('consecutiveNoShows', 0) >= 3)
             || user.get('lastNoShowAt', null) == null
             || request.time > user.lastNoShowAt + duration.value(14, 'd');
    }

    // Kurum belgesi — aktivite kuralları doğrulama durumunu buradan okur.
    // (Aynı get() bir değerlendirme içinde önbelleklenir, tekrar ücret yok.)
    function orgDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data;
    }

    function orgIsVerified(orgId) {
      return orgDoc(orgId).get('verified', false) == true;
    }

    // ---------------------------------------------------------------------
    // users — kullanıcı profili
    // ---------------------------------------------------------------------
    match /users/{userId} {

      // Kendi profilini ve adminler herkesinkini okur.
      // Kurum personelinin katılımcı görmesi Faz 2'de aktivite bağlamıyla
      // açılacak (şimdi kapalı — veri minimizasyonu, CLAUDE.md Bölüm 10).
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();

      // ---------------------------------------------------------------
      // OLUŞTURMA — bilinçli sapma (DECISIONS.md §6).
      //
      // CLAUDE.md profil belgesini `onUserCreate` Cloud Function'ına
      // yaptırıyor. Cloud Functions Blaze planı istiyor; proje sahibi pilot
      // öncesi Blaze'i açmadı. Bu yüzden belgeyi istemci oluşturuyor ve
      // güvenlik buraya yıkılıyor: yalnız kendi belgesi, yalnız izinli
      // alanlar, sayaçlar SIFIR, rol alanları sabit.
      //
      // Kullanıcının kendine puan/seviye/rol basması bu üç koşulla engellenir:
      //   stats == sıfır, trainerStatus == 'none', roleDisplay == 'participant'
      // Blaze açılınca bu kural tekrar `if false` olacak.
      // ---------------------------------------------------------------
      allow create: if isSelf(userId)
                    && request.resource.data.keys().hasOnly([
                         'displayName', 'bio', 'skills', 'interests',
                         'languages', 'locale', 'photoURL', 'city',
                         'email', 'countryCode', 'roleDisplay',
                         'stats', 'trainerStatus', 'createdAt', 'lastActiveAt'
                       ])
                    && request.resource.data.stats == {
                         'ip': 0, 'hours': 0, 'activitiesCompleted': 0,
                         'noShows': 0, 'categoriesCount': 0, 'level': 1
                       }
                    && request.resource.data.trainerStatus == 'none'
                    && request.resource.data.roleDisplay == 'participant'
                    && request.resource.data.email == request.auth.token.email
                    // orgId hiç gönderilemez — kurum üyeliği yalnız sunucudan.
                    && !('orgId' in request.resource.data);

      // ---------------------------------------------------------------
      // HESAP SİLME — DSGVO Art. 17 (CLAUDE.md Bölüm 10, Faz 7, Bölüm 15
      // bitti ölçütü: "Hesap silme tüm izleri kaldırıyor").
      //
      // Yalnız kendi belgesi. `ledger` / `passportEntries` / `vouchers`
      // zaten kullanıcı kimliği dışında kişisel veri TAŞIMIYOR (ad,
      // e-posta, fotoğraf yok — bkz. Bölüm 5 şeması); bu belge silinince
      // oradaki `uid` artık hiçbir profile çözülemeyen, kimliksiz bir
      // işaretçiye düşer. Bölüm 10'daki "ledger anonimleştirilir, silinmez"
      // kuralı böyle sağlanıyor — ayrı bir anonimleştirme yazımı gerekmedi.
      // ---------------------------------------------------------------
      allow delete: if isSelf(userId);

      // Kullanıcı yalnızca şu alanları değiştirebilir (CLAUDE.md Bölüm 14).
      // stats, trainerStatus, orgId, roleDisplay, createdAt → SUNUCU ALANLARI.
      //
      // 🔒 `stats` BU LİSTEDE YOK ve asla olmayacak. Kullanıcı kendine puan,
      // saat, seviye ya da katılım yazamaz. tests/attendance.rules.test.ts
      // bunu saldırı senaryolarıyla kanıtlıyor.
      allow update: if isSelf(userId)
                    && onlyFields([
                         'displayName', 'bio', 'skills', 'interests',
                         'languages', 'locale', 'photoURL', 'city',
                         'lastActiveAt'
                       ]);

      // ---------------------------------------------------------------
      // PUAN YAZIMI — kurum personeli (docs/DECISIONS.md §9)
      //
      // CLAUDE.md Bölüm 12 bunu `onAttendanceConfirmed` tetikleyicisine
      // veriyor. Blaze kapalı, tetikleyici yok; puanı kurum personelinin
      // cihazı yazıyor. Yetki üç şartla iğne deliğine sıkıştırıldı:
      //
      //   1. AYNI COMMIT'te bir pasaport girdisi açılmış olmalı (getAfter),
      //   2. sayaçlardaki artış o girdinin değerleriyle BİREBİR aynı olmalı,
      //   3. yeni seviye eşik tablosunun izin verdiğinden büyük olamaz.
      //
      // Yani kurum "şu kişiye 500 puan" diyemiyor; yalnız kendi
      // aktivitesinin ilan ettiği puanı, kişi başı bir kez verebiliyor —
      // girdi kimliği `{activityId}_{uid}` sabit olduğu için ikinci kez
      // yazmak da mümkün değil.
      //
      // `lastAwardId` hangi girdinin yazıldığını söyler; olmadan kural
      // hangi belgeye bakacağını bilemezdi.
      // ---------------------------------------------------------------
      function awardedEntry() {
        return getAfter(/databases/$(database)/documents/passportEntries/$(request.resource.data.lastAwardId)).data;
      }

      allow update: if signedIn()
                    && onlyFields(['stats', 'lastAwardId'])
                    && request.resource.data.lastAwardId is string
                    && awardedEntry().uid == userId
                    && orgStaff(awardedEntry().orgId)
                    && awardStatsDelta(resource.data.stats,
                                       request.resource.data.stats,
                                       awardedEntry());

      // ---------------------------------------------------------------
      // EĞİTMEN ONAYI — yalnız platform admin (CLAUDE.md Bölüm 8).
      //
      // `trainerStatus` kullanıcının izinli alan listesinde YOK, yani
      // kimse kendini eğitmen yapamaz. Blaze gelince bu yerini
      // `setTrainerRole` claim yazımına bırakır.
      // ---------------------------------------------------------------
      allow update: if isAdmin()
                    && onlyFields(['trainerStatus', 'roleDisplay'])
                    && request.resource.data.trainerStatus
                         in ['none', 'pending', 'approved', 'rejected'];

      // ---------------------------------------------------------------
      // IP HARCAMA — ödül mağazasından alım (CLAUDE.md Bölüm 7.2).
      //
      // Kullanıcı kendi puanını DÜŞÜREBİLİR ama yalnız aynı commit'te
      // bastığı kuponun fiyatı kadar. Artıramaz, başka alana dokunamaz,
      // eksiye düşemez. `lastSpendId` hangi kuponun ödendiğini söylüyor.
      //
      // "Bakiyeyi düşürmek zararsız" değil: düşürülmeden kupon basılsaydı
      // ödül bedava olurdu, fazla düşürülseydi defter tutmazdı.
      // ---------------------------------------------------------------
      function spentVoucher() {
        return getAfter(/databases/$(database)/documents/vouchers/$(request.resource.data.lastSpendId)).data;
      }

      allow update: if isSelf(userId)
                    && onlyFields(['stats', 'lastSpendId'])
                    && spentVoucher().uid == userId
                    && request.resource.data.stats.ip
                         == resource.data.stats.ip - spentVoucher().costIp
                    && request.resource.data.stats.ip >= 0
                    && request.resource.data.stats.hours == resource.data.stats.hours
                    && request.resource.data.stats.activitiesCompleted
                         == resource.data.stats.activitiesCompleted
                    && request.resource.data.stats.categoriesCount
                         == resource.data.stats.categoriesCount
                    && request.resource.data.stats.noShows == resource.data.stats.noShows
                    && request.resource.data.stats.consecutiveNoShows
                         == resource.data.stats.consecutiveNoShows
                    && request.resource.data.stats.level == resource.data.stats.level;

      // ---------------------------------------------------------------
      // NO-SHOW CEZASI — CLAUDE.md Bölüm 6 (item 7)
      //
      // Hangi aktiviteden dolayı ceza verildiği `lastNoShowActivityId` ile
      // söyleniyor ve kural onu doğruluyor: aktivite bu kurumun olmalı,
      // BİTMİŞ olmalı, kişinin de o aktivitede KABUL EDİLMİŞ başvurusu
      // olmalı. Rastgele bir kullanıcıya ceza yazılamıyor.
      //
      // `lastNoShowAt == request.time` şartı da kritik: ileri tarihli bir
      // damga yazılıp kısıt süresi uzatılamıyor. Kısıt ayrı bir alan
      // değil, bu damgadan hesaplanıyor (bkz. notRestricted()).
      // ---------------------------------------------------------------
      function noShowActivity() {
        return get(/databases/$(database)/documents/activities/$(request.resource.data.lastNoShowActivityId)).data;
      }

      function wasAccepted(activityId) {
        let path = /databases/$(database)/documents/activities/$(activityId)/applicants/$(userId);
        return exists(path) && get(path).data.status == 'accepted';
      }

      allow update: if signedIn()
                    && onlyFields(['stats', 'lastNoShowAt', 'lastNoShowActivityId'])
                    && request.resource.data.lastNoShowAt == request.time
                    && orgStaff(noShowActivity().orgId)
                    && noShowActivity().endAt < request.time
                    && wasAccepted(request.resource.data.lastNoShowActivityId)
                    && noShowStatsDelta(resource.data.stats,
                                        request.resource.data.stats);

      // users/{uid}/private/** — bildirim tercihleri, push token'ları
      match /private/{docId} {
        allow read, write: if isSelf(userId);
      }

      // users/{uid}/applications — KULLANILMIYOR.
      // Başvuru tek yerde durur: activities/{id}/applicants/{uid}
      // (gerekçe: app/src/types/activity.ts, Application açıklaması).
      // Kural yine de burada: eski bir istemci sürümü yazmaya kalkarsa
      // sessizce ikinci bir gerçek kaynak oluşmasın.
      match /applications/{activityId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // organizations — kurumlar
    // ---------------------------------------------------------------------
    match /organizations/{orgId} {
      // Doğrulanmış kurumu giriş yapmış herkes görür; doğrulanmamışı yalnız
      // kendi personeli, başvuruyu yapan kişi ve admin görür.
      function canSeeOrg() {
        return resource.data.get('verified', false) == true
               || resource.data.get('appliedBy', '') == uid()
               || orgStaff(orgId)
               || isAdmin();
      }

      allow get: if signedIn() && canSeeOrg();

      // list kuralı HER BELGE için ayrı değerlendirilir: doğrulanmamış bir
      // kurumu kapsayan sorgu, personeli olmayan kullanıcıda komple düşer.
      allow list: if signedIn() && canSeeOrg();

      // ---------------------------------------------------------------
      // BAŞVURU (CLAUDE.md Bölüm 4: "Bir kurum kendi başına kayıt olamaz")
      //
      // Kayıt olabilir ama YETKİ KAZANAMAZ: verified=false ve status='pending'
      // zorunlu, bütçe alanı yasak, parasal kupon kapalı. Bu hâldeki kurum
      // aktivite yayınlayamaz (aşağıdaki activities kuralı verified arıyor).
      // ---------------------------------------------------------------
      allow create: if verified()
                    && request.resource.data.appliedBy == uid()
                    && request.resource.data.verified == false
                    && request.resource.data.status == 'pending'
                    && request.resource.data.reviewedBy == null
                    && request.resource.data.features.cashVouchers == false
                    && !('budget' in request.resource.data)
                    && !('seed' in request.resource.data)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 120;

      // İNCELEME — yalnız platform admin. `approveOrganization` (Bölüm 12).
      allow update: if isAdmin()
                    && onlyFields(['verified', 'status', 'reviewedBy',
                                   'reviewedAt', 'reviewNote',
                                   'features', 'logoURL'])
                    && request.resource.data.reviewedBy == uid();

      // PROFİL DÜZENLEME — kurum yöneticisi. Doğrulama ve bütçe alanlarına
      // dokunamaz; dokunabilseydi kendi kurumunu "geprüft" yapardı.
      allow update: if orgAdmin(orgId)
                    && onlyFields(['logoURL', 'website', 'contactEmail',
                                   'description', 'city'])
                    && unchanged('verified')
                    && unchanged('status');

      allow delete: if false;

      // -----------------------------------------------------------------
      // organizations/{orgId}/members/{uid} — kurum ekibi
      // -----------------------------------------------------------------
      match /members/{memberUid} {
        function validRole() {
          return request.resource.data.role in
                 ['org_admin', 'org_staff', 'redemption_officer', 'partner'];
        }

        function consistent() {
          return request.resource.data.uid == memberUid
                 && request.resource.data.orgId == orgId
                 && validRole();
        }

        allow get: if isSelf(memberUid) || orgStaff(orgId) || isAdmin();
        allow list: if orgStaff(orgId) || isAdmin();

        // Kullanıcının "hangi kurumlardayım" sorgusu (collectionGroup).
        // Sorgu `where('uid','==',me)` ile geldiği için başkasının üyeliği
        // hiçbir koşulda dönmez.
        allow create: if consistent() && (
                        orgAdmin(orgId)
                        // İLK YÖNETİCİ: kurumu başvuru anında açan kişi,
                        // aynı commit içinde kendini org_admin yazar.
                        // getAfter → başvuru belgesi gerçekten bu commit'te
                        // ve 'pending' durumunda oluşuyor mu?
                        || (isSelf(memberUid)
                            && request.resource.data.role == 'org_admin'
                            && getAfter(/databases/$(database)/documents/organizations/$(orgId))
                                 .data.appliedBy == uid()
                            && getAfter(/databases/$(database)/documents/organizations/$(orgId))
                                 .data.status == 'pending')
                      );

        allow update: if consistent() && orgAdmin(orgId);

        // Çıkarma yalnız kurum yöneticisinde — ARTI kendi üyeliğini
        // silebilme (Faz 7 hesap silme akışı, docs/DECISIONS.md §13).
        // Son yönetici kendini çıkarırsa kurum sahipsiz kalır; bu uç durum
        // istemcide (OrgPanel "son admin" uyarısı) önlenir, burada değil —
        // hesabını silen kişinin zaten geri dönüşü yok.
        allow delete: if orgAdmin(orgId) || isSelf(memberUid);
      }
    }

    // Collection group: "hangi kurumlarda üyeyim?"
    // Sorgu kısıtı ile kural birebir örtüşmezse Firestore sorguyu reddeder,
    // yani kimse başkasının üyeliğini listeleyemez.
    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.get('uid', '') == uid();
    }

    // ---------------------------------------------------------------------
    // categories — sabit kategori sözlüğü
    // ---------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if signedIn();
      // Kategori sözlüğü koddaki CATEGORY_IDS ile aynı; Firestore kopyasını
      // yalnız platform admin (ve seed scripti, Admin SDK ile) yazar.
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // activities — aktiviteler ve eğitimler
    // ---------------------------------------------------------------------
    match /activities/{activityId} {

      // -----------------------------------------------------------------
      // OKUMA — CLAUDE.md Bölüm 14:
      // "status == 'published' herkes (giriş yapmış); taslaklar yalnız
      //  ilgili kurum üyeleri."
      //
      // `list` de aynı koşulu kullanıyor: kural her belge için ayrı
      // değerlendirildiğinden, taslakları kapsayan bir sorgu kurum
      // personeli olmayan kullanıcıda komple reddedilir.
      // -----------------------------------------------------------------
      function canSeeActivity() {
        return resource.data.status == 'published'
               || resource.data.status == 'completed'
               || resource.data.status == 'cancelled'
               || orgStaff(resource.data.orgId)
               || isAdmin()
               || (isTrainer() && resource.data.get('trainerUid', '') == uid());
      }

      allow get: if signedIn() && canSeeActivity();
      allow list: if signedIn() && canSeeActivity();

      // -----------------------------------------------------------------
      // OLUŞTURMA — kurum personeli, HER ZAMAN taslak olarak.
      //
      // Doğrudan 'published' yazılamaz: yayın kararı platform admin'in
      // (reviewActivity). Sayaçlar sıfırdan başlar, `seed` işareti
      // istemciden gelemez (o yalnız seed scriptinin damgası).
      // -----------------------------------------------------------------
      function contentFieldsValid() {
        return request.resource.data.capacity is int
               && request.resource.data.capacity >= 1
               && request.resource.data.capacity <= 1000
               && request.resource.data.rewards.ip is int
               && request.resource.data.rewards.ip >= 0
               && request.resource.data.rewards.ip <= 60
               && request.resource.data.hoursCredited >= 0
               && request.resource.data.hoursCredited <= 24
               && request.resource.data.minLevel is int
               && request.resource.data.minLevel >= 0
               && request.resource.data.minLevel <= 5
               && request.resource.data.startAt is timestamp
               && request.resource.data.endAt is timestamp
               && request.resource.data.endAt > request.resource.data.startAt;
      }

      // Eğitmen kendi eğitimini önerir (Bölüm 8): kurum personeli olmasa da
      // `type: 'training'` ve `trainerUid` kendisi olan bir TASLAK açabilir.
      // Yayına yine kurum/admin onayıyla girer — öneri, yayın değil.
      function trainerProposal() {
        return isTrainer()
               && request.resource.data.type == 'training'
               && request.resource.data.get('trainerUid', '') == uid();
      }

      allow create: if verified()
                    && (orgStaff(request.resource.data.orgId) || trainerProposal())
                    && request.resource.data.createdBy == uid()
                    && request.resource.data.status == 'draft'
                    && request.resource.data.stats == { 'applicants': 0, 'attendees': 0 }
                    && request.resource.data.reviewedBy == null
                    && !('seed' in request.resource.data)
                    && contentFieldsValid();

      // Taslak silinebilir; yayınlanmış/incelemedeki aktivite SİLİNMEZ —
      // başvuran birinin geçmişi altından çekilmesin (iptal edilir).
      allow delete: if orgStaff(resource.data.orgId)
                    && resource.data.status == 'draft'
                    && resource.data.stats.applicants == 0;

      // -----------------------------------------------------------------
      // GÜNCELLEME 1/3 — içerik düzenleme (kurum personeli).
      // Durum, sahiplik, sayaç ve moderasyon alanlarına DOKUNAMAZ.
      // -----------------------------------------------------------------
      allow update: if orgStaff(resource.data.orgId)
                    && resource.data.status in ['draft', 'pending_review', 'published']
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['orgId', 'createdBy', 'status', 'stats', 'seed',
                                  'submittedAt', 'reviewedBy', 'reviewedAt',
                                  'reviewNote', 'createdAt'])
                    && contentFieldsValid();

      // -----------------------------------------------------------------
      // GÜNCELLEME 2/3 — durum geçişleri (submitActivity / reviewActivity).
      //
      // İzinli geçişler:
      //   kurum : draft → pending_review     (onaya gönder)
      //           pending_review → draft     (incelemeden geri çek)
      //           published → cancelled      (iptal)
      //           draft/pending_review → cancelled
      //   admin : pending_review → published (kurum DOĞRULANMIŞSA)
      //           pending_review → draft     (gerekçeyle reddet)
      //           published → cancelled      (moderasyon)
      // Başka hiçbir geçiş yok; özellikle draft → published YOK.
      // -----------------------------------------------------------------
      function statusOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'submittedAt', 'reviewedBy',
                           'reviewedAt', 'reviewNote']);
      }

      function from() { return resource.data.status; }
      function to()   { return request.resource.data.status; }

      allow update: if statusOnly() && orgStaff(resource.data.orgId) && (
                         (from() == 'draft' && to() == 'pending_review')
                      || (from() == 'pending_review' && to() == 'draft')
                      || (from() in ['draft', 'pending_review', 'published']
                          && to() == 'cancelled')
                    );

      allow update: if statusOnly() && isAdmin()
                    && request.resource.data.reviewedBy == uid()
                    && (
                         (from() == 'pending_review' && to() == 'published'
                          && orgIsVerified(resource.data.orgId))
                      || (from() == 'pending_review' && to() == 'draft')
                      || (from() == 'published' && to() == 'cancelled')
                    );

      // -----------------------------------------------------------------
      // GÜNCELLEME 3/3 — kontenjan sayacı (applyToActivity / geri çekme).
      //
      // 🔒 Sayaç tek başına oynatılamaz. `getAfter`, AYNI COMMIT içinde
      // çağıranın kendi başvuru belgesinin oluştuğunu/geri çekildiğini
      // doğruluyor. Yani +1 için gerçekten bir başvuru yazılmış olmalı,
      // −1 için de o başvuru 'withdrawn' olmalı. Başkasının adına ya da
      // boşa sayaç değiştirmek mümkün değil.
      // `attendees` bu yoldan asla değişmez (Faz 3, yoklama işi).
      // -----------------------------------------------------------------
      function myApplicantAfter() {
        return getAfter(/databases/$(database)/documents/activities/$(activityId)/applicants/$(uid())).data;
      }

      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats'])
                    && request.resource.data.stats.attendees == resource.data.stats.attendees
                    && (
                         (request.resource.data.stats.applicants == resource.data.stats.applicants + 1
                          && myApplicantAfter().status == 'applied')
                      || (request.resource.data.stats.applicants == resource.data.stats.applicants - 1
                          && myApplicantAfter().status == 'withdrawn')
                    );

      // =================================================================
      // activities/{id}/applicants/{uid} — başvurular
      //
      // CLAUDE.md Bölüm 12 `applyToActivity`: kontenjan ve son başvuru
      // kontrolü. Cloud Function olmadığı için kontroller BURADA:
      // aktivite belgesi get() ile okunup kapasite, tarih ve durum
      // doğrulanıyor. İstemci transaction'ı yalnız yarışı çözüyor.
      // =================================================================
      match /applicants/{applicantUid} {
        function act() {
          return get(/databases/$(database)/documents/activities/$(activityId)).data;
        }

        allow get: if isSelf(applicantUid) || orgStaff(act().orgId) || isAdmin();
        allow list: if orgStaff(act().orgId) || isAdmin();

        allow create: if isSelf(applicantUid)
                      && verified()
                      // CLAUDE.md Bölüm 6: 3 ardışık no-show → 14 gün kısıt.
                      && notRestricted(applicantUid)
                      && act().status == 'published'
                      && act().requiresApplication == true
                      && act().stats.applicants < act().capacity
                      && request.time < act().startAt
                      && (act().applicationDeadline == null
                          || request.time < act().applicationDeadline)
                      && request.resource.data.uid == uid()
                      && request.resource.data.activityId == activityId
                      && request.resource.data.orgId == act().orgId
                      && request.resource.data.status == 'applied'
                      && request.resource.data.attended == false
                      && request.resource.data.decidedAt == null
                      && request.resource.data.decidedBy == null
                      && request.resource.data.decisionNote == ''
                      && request.resource.data.message is string
                      && request.resource.data.message.size() <= 500;

        // Katılımcı kendi başvurusunu geri çeker. Başka hiçbir alana
        // dokunamaz — özellikle `attended` ve `status: accepted` yasak.
        allow update: if isSelf(applicantUid)
                      && onlyFields(['status', 'withdrawnAt'])
                      && resource.data.status in ['applied', 'accepted']
                      && request.resource.data.status == 'withdrawn';

        // `decideApplication` — kurum kabul/red.
        allow update: if orgStaff(act().orgId)
                      && onlyFields(['status', 'decidedAt', 'decidedBy', 'decisionNote'])
                      && resource.data.status == 'applied'
                      && request.resource.data.status in ['accepted', 'rejected']
                      && request.resource.data.decidedBy == uid();

        // HESAP SİLME — `applicantName` izini sil (Faz 7, DECISIONS §13).
        // Aynı gerekçe: kurum personeli `users` koleksiyonunu okuyamadığı
        // için başvuruya ad kopyalanmış. Yalnız bu TEK alan, yalnız boş
        // dizgeye — kontenjan sayacını besleyen `status` dokunulmaz kalır.
        allow update: if isSelf(applicantUid)
                      && onlyFields(['applicantName'])
                      && request.resource.data.applicantName == '';

        // Başvuru silinmez: kontenjan sayacı silinen belgeyi kanıtlayamaz
        // ve kurumun "kaç kişi vazgeçti" görünürlüğü kaybolur.
        allow delete: if false;
      }
    }

    // =====================================================================
    // activities/{id}/feedback/{uid} — eğitim geri bildirimi (Bölüm 8)
    //
    // "1–5 yıldız + yorum … Yorumlar kurum tarafından gizlenebilsin."
    // Yorum SİLİNMİYOR, gizleniyor: silme, kötü geri bildirimi yok etmenin
    // kolay yolu olurdu.
    // =====================================================================
    match /activities/{activityId}/feedback/{authorUid} {
      function act() {
        return get(/databases/$(database)/documents/activities/$(activityId)).data;
      }

      function attended() {
        let path = /databases/$(database)/documents/passportEntries/$(activityId + '_' + uid());
        return exists(path);
      }

      allow get, list: if signedIn();

      // Yalnız KATILMIŞ kişi yorum yazabilir — pasaport girdisi kanıt.
      allow create: if isSelf(authorUid)
                    && verified()
                    && attended()
                    && request.resource.data.uid == uid()
                    && request.resource.data.activityId == activityId
                    && request.resource.data.orgId == act().orgId
                    && request.resource.data.trainerUid == act().get('trainerUid', '')
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.hidden == false
                    && request.resource.data.comment.size() <= 600;

      // Yazan kendi yorumunu düzeltebilir; gizleme bayrağına dokunamaz.
      allow update: if isSelf(authorUid)
                    && onlyFields(['rating', 'comment'])
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      // Kurum gizler/gösterir.
      allow update: if orgStaff(act().orgId) && onlyFields(['hidden']);

      allow delete: if false;
    }

    // Eğitmenin tüm geri bildirimleri — profilindeki ortalama için.
    //
    // ⚠️ `{path=**}` SIFIR segmenti de eşler, yani bu kural kök seviyedeki
    // `feedback` koleksiyonuna (platforma yazılan geri bildirim, Bölüm 5) da
    // uyar. Orası admin'e özel olduğu için `trainerUid` şartı konuldu:
    // eğitim geri bildiriminde bu alan var, platform geri bildiriminde yok.
    // Sorgu da `where('trainerUid','==',...)` ile geldiği için kural ve
    // sorgu örtüşüyor.
    match /{path=**}/feedback/{authorUid} {
      allow list: if signedIn() && resource.data.get('trainerUid', '') != '';
    }

    // "Başvurularım" — collection group. Sorgu `where('uid','==',me)`.
    match /{path=**}/applicants/{applicantUid} {
      allow list: if signedIn() && resource.data.get('uid', '') == uid();
    }

    // ---------------------------------------------------------------------
    // attendanceSessions — yoklama oturumları
    // ---------------------------------------------------------------------
    match /attendanceSessions/{sessionId} {
      // Katılımcının oturumun AÇIK olduğunu görmesi yeterli; kodu GÖRMEZ.
      // (Kod ayrı bir alt belgede ve o belge hiçbir istemciye okunmuyor.)
      allow get: if signedIn();
      allow list: if signedIn() && orgStaff(resource.data.orgId);

      // `startAttendanceSession` — yalnız kurum personeli, yalnız kendi
      // kurumunun aktivitesi için, yalnız YAYINDAKİ aktiviteye.
      // Eğitmen KENDİ eğitiminde yoklama başlatabilir (Bölüm 8).
      function ownTraining() {
        return isTrainer()
               && get(/databases/$(database)/documents/activities/$(request.resource.data.activityId))
                    .data.get('trainerUid', '') == uid();
      }

      allow create: if (orgStaff(request.resource.data.orgId) || ownTraining())
                    && request.resource.data.startedBy == uid()
                    && request.resource.data.active == true
                    && request.resource.data.rotationSeconds is int
                    && request.resource.data.rotationSeconds >= 10
                    && request.resource.data.rotationSeconds <= 600
                    && request.resource.data.geoRadiusMeters is int
                    && request.resource.data.geoRadiusMeters >= 10
                    && request.resource.data.geoRadiusMeters <= 20000
                    && orgDoc(request.resource.data.orgId).get('verified', false) == true;

      // `stopAttendanceSession` — durum kapatma ve bitiş damgası.
      allow update: if orgStaff(resource.data.orgId)
                    && onlyFields(['active', 'endedAt', 'rotationSeconds',
                                   'requireGeo', 'geoRadiusMeters']);

      allow delete: if false;

      // 🔒 KRİTİK: dönen QR kodları HİÇBİR istemciye OKUNMAZ.
      // Okunabilseydi, etkinliğe hiç gitmeden yoklama verilebilirdi.
      //
      // Yazma yalnız oturumu yöneten kurum personeline açık: kodu üreten
      // taraf o. Kural bu belgeyi `get()` ile okuyup taranan kodu
      // doğruluyor — kurallar okuma izinlerine tabi değildir, bu yüzden
      // "kimse okuyamaz ama doğrulama yine de sunucuda yapılır" mümkün.
      // (docs/DECISIONS.md §9)
      match /codes/{codeId} {
        allow read: if false;
        allow write: if orgStaff(
                          get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.orgId
                        );
      }
    }

    // ---------------------------------------------------------------------
    // attendanceRecords — yoklama kayıtları
    // ---------------------------------------------------------------------
    match /attendanceRecords/{recordId} {

      function session() {
        return get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data;
      }

      // Okunamayan kod belgesi — doğrulamanın kalbi.
      function liveCode() {
        return get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)/codes/current).data;
      }

      function codePath() {
        return /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)/codes/current;
      }

      // Kullanıcının o anki gerçek sayaçları — kayda kopyalanan snapshot
      // bununla karşılaştırılıyor, yani uydurulamıyor.
      function realStats() {
        return get(/databases/$(database)/documents/users/$(uid())).data.stats;
      }

      allow get: if signedIn() && (resource.data.uid == uid()
                                   || orgStaff(resource.data.orgId)
                                   || isAdmin());
      // Kurum kendi oturumunun/aktivitesinin kayıtlarını listeler.
      // Kullanıcı kendi kayıtlarını da listeleyebilir (Faz 7, DSGVO Art. 20
      // `exportMyData` — docs/DECISIONS.md §13): verisini indirmek için
      // tek tek belge kimliğini bilmesi gerekmemeli.
      allow list: if signedIn() && (isAdmin()
                                    || orgStaff(resource.data.orgId)
                                    || resource.data.uid == uid());

      // -----------------------------------------------------------------
      // `submitScan` — CLAUDE.md Bölüm 12 hata kodlarının kural karşılığı:
      //   inactive        → session().active != true
      //   expired         → request.time > liveCode().expiresAt
      //   wrong-code      → imza/manuel kod eşleşmiyor
      //   already-recorded→ belge kimliği sabit, ikinci create düşer
      //
      // Belge kimliği `{sessionId}_{uid}` olmak ZORUNDA: yoksa aynı kişi
      // farklı kimliklerle defalarca yazılabilirdi.
      // -----------------------------------------------------------------
      function validQrScan() {
        return exists(codePath())
               && request.resource.data.signature == liveCode().nonce
               && request.time < liveCode().expiresAt;
      }

      function validManualScan() {
        return exists(codePath())
               && request.resource.data.method == 'manual_code'
               && request.resource.data.signature == liveCode().manualCode;
      }

      function scanShapeOk() {
        return recordId == request.resource.data.sessionId + '_' + uid()
               && request.resource.data.uid == uid()
               && request.resource.data.orgId == session().orgId
               && request.resource.data.activityId == session().activityId
               && request.resource.data.awarded == false
               && request.resource.data.statsSnapshot.ip == realStats().ip
               && request.resource.data.statsSnapshot.hours == realStats().hours
               && request.resource.data.statsSnapshot.activitiesCompleted
                    == realStats().activitiesCompleted
               && request.resource.data.statsSnapshot.categoriesCount
                    == realStats().categoriesCount;
      }

      // Canlı tarama → doğrudan `confirmed`.
      allow create: if verified()
                    && scanShapeOk()
                    && session().active == true
                    && request.resource.data.status == 'confirmed'
                    && (validQrScan() || validManualScan());

      // Geç / çevrimdışı tarama → `pending_review`. İmza doğrulanamıyor
      // (kod çoktan döndü), bu yüzden puan ancak kurum ONAYLARSA yazılır.
      allow create: if verified()
                    && scanShapeOk()
                    && request.resource.data.status == 'pending_review'
                    && request.resource.data.method == 'offline_late';

      // `approveLateScans` — yalnız kurum personeli, yalnız durum alanları.
      allow update: if orgStaff(resource.data.orgId)
                    && onlyFields(['status', 'method'])
                    && resource.data.status == 'pending_review'
                    && request.resource.data.status in ['confirmed', 'rejected'];

      // Puanlandı işareti — pasaport girdisi aynı commit'te açılmış olmalı.
      allow update: if orgStaff(resource.data.orgId)
                    && onlyFields(['awarded'])
                    && request.resource.data.awarded == true;

      // -----------------------------------------------------------------
      // HESAP SİLME — `displayName` izini sil (Faz 7, docs/DECISIONS.md §13)
      //
      // Bu belge kurum personelinin canlı yoklama listesinde isim görmesi
      // için `displayName` KOPYASI taşıyor (orgStaff `users` koleksiyonunu
      // okuyamaz). `users/{uid}` silindiğinde bu kopya geride kalan tek
      // isim izi olurdu. Kullanıcı yalnız KENDİ kaydındaki bu TEK alanı,
      // yalnız boş dizgeye çevirebilir — tarih, durum, puan gibi hiçbir
      // şeye dokunamaz.
      // -----------------------------------------------------------------
      allow update: if signedIn()
                    && resource.data.uid == uid()
                    && onlyFields(['displayName'])
                    && request.resource.data.displayName == '';

      // Kayıt SİLİNMEZ: pasaport girdisinin dayanağı bu belge.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // passportEntries — Integrationspass girdileri
    // ---------------------------------------------------------------------
    match /passportEntries/{entryId} {

      function activityOf() {
        return get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data;
      }

      // Katılımın DAYANAĞI: o kişinin o aktivitede onaylı yoklama kaydı.
      function hasConfirmedAttendance() {
        let path = /databases/$(database)/documents/attendanceRecords/$(request.resource.data.sessionId + '_' + request.resource.data.uid);
        return exists(path) && get(path).data.status == 'confirmed';
      }

      // "Kullanıcı bunu ASLA doğrudan yazamaz" (CLAUDE.md Bölüm 5).
      allow get: if signedIn() && (resource.data.uid == uid()
                                   || orgStaff(resource.data.orgId)
                                   || isAdmin());
      allow list: if signedIn() && (resource.data.uid == uid()
                                    || orgStaff(resource.data.orgId)
                                    || isAdmin());

      // -----------------------------------------------------------------
      // Girdiyi kurum personeli açar (docs/DECISIONS.md §9). Sınırlar:
      //   · kimlik `{activityId}_{uid}` → kişi başı BİR kez (idempotent)
      //   · `ipAwarded` aktivitenin ilan ettiği puana EŞİT
      //   · `hours` aktivitenin `hoursCredited` değerine EŞİT
      //   · 'attendance' kaynağı için onaylı yoklama kaydı ŞART
      //   · 'admin' kaynağı için onaylanmış bir pendingClaim ŞART
      // Güncelleme ve silme HİÇ yok: pasaport geçmişi değiştirilemez.
      // -----------------------------------------------------------------
      function entryShapeOk() {
        return entryId == request.resource.data.activityId + '_' + request.resource.data.uid
               && orgStaff(request.resource.data.orgId)
               && request.resource.data.orgId == activityOf().orgId
               && request.resource.data.status == 'completed'
               // Eğitmen kendi eğitimini verdiyse Bölüm 6'daki ×1.5 çarpanı.
               && (request.resource.data.ipAwarded == activityOf().rewards.ip
                   || (activityOf().get('trainerUid', '') == request.resource.data.uid
                       && request.resource.data.ipAwarded
                            == math.round(activityOf().rewards.ip * 1.5)))
               && request.resource.data.hours == activityOf().hoursCredited
               && request.resource.data.categoryId == activityOf().categoryId;
      }

      function approvedClaim() {
        let path = /databases/$(database)/documents/pendingClaims/$(request.resource.data.activityId + '_' + request.resource.data.uid);
        return exists(path) && get(path).data.status == 'approved';
      }

      allow create: if entryShapeOk()
                    && ((request.resource.data.source == 'attendance'
                         && hasConfirmedAttendance())
                     || (request.resource.data.source == 'admin'
                         && approvedClaim()));

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // pendingClaims — "katıldım" iddiaları (kanıt fotoğraflı)
    // ---------------------------------------------------------------------
    match /pendingClaims/{claimId} {
      // BazaltGo'daki `bekleyenOnaylar` karşılığı: "katıldım ama yoklama
      // alınmadı" iddiası (CLAUDE.md Bölüm 2 onay akışı).
      allow get, list: if signedIn() && (resource.data.uid == uid()
                                         || orgStaff(resource.data.orgId)
                                         || isAdmin());

      function claimActivity() {
        return get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data;
      }

      // Kullanıcı kendi iddiasını açar; sonrasında DEĞİŞTİREMEZ.
      // Kimlik `{activityId}_{uid}` → aktivite başına tek iddia.
      // Aktivite bitmeden iddia açılamaz: henüz gidip yoklama verebilir.
      allow create: if verified()
                    && claimId == request.resource.data.activityId + '_' + uid()
                    && request.resource.data.uid == uid()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.reviewedBy == null
                    && request.resource.data.orgId == claimActivity().orgId
                    && claimActivity().endAt < request.time
                    // Fotoğraf Storage yerine belgede (docs/DECISIONS.md §7).
                    // Sınır Firestore belge sınırının çok altında tutuluyor.
                    && request.resource.data.photoDataUrl is string
                    && request.resource.data.photoDataUrl.size() <= 500000;

      // Kararı yalnız ilgili kurumun personeli verir.
      allow update: if orgStaff(resource.data.orgId)
                    && onlyFields(['status', 'reviewedBy', 'reviewedAt', 'reviewNote'])
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['approved', 'rejected']
                    && request.resource.data.reviewedBy == uid();

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // rewardTemplates — ödül şablonları
    // ---------------------------------------------------------------------
    match /rewardTemplates/{templateId} {
      allow get, list: if signedIn();

      // -----------------------------------------------------------------
      // ŞABLON OLUŞTURMA — yalnız kurum yöneticisi (CLAUDE.md Bölüm 7.1).
      //
      // 🔒 `cash_voucher` GERÇEK PARADIR. Bölüm 7.6 + Bölüm 10: kurum bazında
      // açılır, varsayılan KAPALI, açma yetkisi yalnız platform admin'de
      // (organizations update kuralında `features` yalnız admin'e açık).
      // Kural kurumun bayrağını okuyup doğruluyor — arayüzde seçeneği
      // gizlemek yetmez, doğrudan yazmayı deneyen istemci de düşmeli.
      // -----------------------------------------------------------------
      function cashAllowed(orgId) {
        return orgDoc(orgId).get('features', {}).get('cashVouchers', false) == true;
      }

      allow create: if orgAdmin(request.resource.data.orgId)
                    && request.resource.data.createdBy == uid()
                    && request.resource.data.valueCents is int
                    && request.resource.data.valueCents >= 0
                    && request.resource.data.valueCents <= 50000
                    && request.resource.data.costIp is int
                    && request.resource.data.costIp >= 0
                    && request.resource.data.costIp <= 10000
                    && request.resource.data.validityDays is int
                    && request.resource.data.validityDays >= 1
                    && request.resource.data.validityDays <= 730
                    && request.resource.data.maxPerUserPerMonth is int
                    && request.resource.data.maxPerUserPerMonth >= 1
                    && request.resource.data.maxPerUserPerMonth <= 50
                    && (request.resource.data.kind != 'cash_voucher'
                        || cashAllowed(request.resource.data.orgId))
                    // Sayaçlar SIFIRDAN başlar; dolu bir sayaçla şablon
                    // açmak bütçe kontrolünü baştan yanıltırdı.
                    && request.resource.data.issuedCount == 0
                    && request.resource.data.spentCents == 0
                    && !('seed' in request.resource.data);

      // Kurum içeriği düzenler; SAYAÇLARA ve kuruma dokunamaz.
      allow update: if orgAdmin(resource.data.orgId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['orgId', 'createdBy', 'issuedCount',
                                  'spentCents', 'seed', 'createdAt'])
                    && (request.resource.data.kind != 'cash_voucher'
                        || cashAllowed(resource.data.orgId));

      // -----------------------------------------------------------------
      // BÜTÇE SAYACI — kupon basılırken (docs/DECISIONS.md §10).
      //
      // 🔒 Bütçe AŞILAMAZ (Bölüm 7.1). Kural `resource.data`yı, yani commit
      // anındaki GERÇEK değeri kullanıyor; istemcinin okuması bayat olsa
      // bile tavan tutuyor. İki kişi aynı anda son kuponu almaya çalışırsa
      // ikincisi tam burada düşer.
      //
      // `lastVoucherId` hangi kuponun basıldığını söylüyor; `getAfter` ile
      // o kuponun AYNI COMMIT'te, bu şablondan ve doğru değerle açıldığı
      // doğrulanıyor. Yoksa sayaç boşuna oynatılabilirdi.
      // -----------------------------------------------------------------
      function issuedVoucher() {
        return getAfter(/databases/$(database)/documents/vouchers/$(request.resource.data.lastVoucherId)).data;
      }

      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['issuedCount', 'spentCents', 'lastVoucherId'])
                    && request.resource.data.issuedCount
                         == resource.data.issuedCount + 1
                    && request.resource.data.spentCents
                         == resource.data.spentCents + resource.data.valueCents
                    && (resource.data.totalBudgetCents == null
                        || request.resource.data.spentCents
                             <= resource.data.totalBudgetCents)
                    && issuedVoucher().templateId == templateId
                    && issuedVoucher().valueCents == resource.data.valueCents
                    && issuedVoucher().uid == uid();

      allow delete: if false;

      // -----------------------------------------------------------------
      // Kişi başı aylık sınır (CLAUDE.md Bölüm 7.5).
      //
      // Ay anahtarı yerine DÖNEM BAŞLANGICI saklanıyor: kural takvim ayını
      // hesaplayamaz ama "başlangıç + 31 gün geçti mi" sorusunu sorabilir.
      // Damga `request.time` olmak zorunda, yani geriye çekilip sınır
      // sıfırlanamıyor.
      // -----------------------------------------------------------------
      match /holders/{holderUid} {
        function template() {
          return get(/databases/$(database)/documents/rewardTemplates/$(templateId)).data;
        }

        allow get: if isSelf(holderUid) || orgAdmin(template().orgId) || isAdmin();
        allow list: if orgAdmin(template().orgId) || isAdmin();

        // İlk alım ya da yeni dönem: sayaç 1'den başlar.
        allow create: if isSelf(holderUid)
                      && request.resource.data.uid == uid()
                      && request.resource.data.count == 1
                      && request.resource.data.periodStart == request.time
                      && template().maxPerUserPerMonth >= 1;

        allow update: if isSelf(holderUid)
                      && onlyFields(['count', 'periodStart'])
                      && (
                           // Aynı dönem: sayaç bir artar, sınırı aşamaz.
                           (request.resource.data.periodStart == resource.data.periodStart
                            && request.resource.data.count == resource.data.count + 1
                            && request.resource.data.count <= template().maxPerUserPerMonth
                            && request.time < resource.data.periodStart + duration.value(31, 'd'))
                        || // Dönem doldu: sıfırdan başla.
                           (request.time >= resource.data.periodStart + duration.value(31, 'd')
                            && request.resource.data.periodStart == request.time
                            && request.resource.data.count == 1)
                         );

        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // vouchers — verilmiş kuponlar  💶
    // ---------------------------------------------------------------------
    match /vouchers/{voucherId} {

      function template() {
        return get(/databases/$(database)/documents/rewardTemplates/$(request.resource.data.templateId)).data;
      }

      // Veznenin/partnerin yetkisi: kuponu basan kurum ya da indirimi veren
      // işletme. Başka kurumun kuponu okutulamaz (Bölüm 7.4).
      function canRedeem(voucher) {
        return inOrg(voucher.orgId, ['redemption_officer', 'org_admin'])
               || (voucher.partnerOrgId != null
                   && inOrg(voucher.partnerOrgId, ['partner', 'org_admin']));
      }

      // Kullanıcı kendi kuponunu görür. Kupon QR'ı BU BELGEDEN üretilmez —
      // 60 sn ömürlü token ayrı, okunamayan bir alt belgede (Bölüm 7.4),
      // böylece ekran görüntüsü tekrar kullanılamaz.
      allow get: if signedIn() && (resource.data.uid == uid()
                                   || canRedeem(resource.data)
                                   || isAdmin());
      allow list: if signedIn() && (resource.data.uid == uid()
                                    || isAdmin()
                                    || orgStaff(resource.data.orgId));

      // -----------------------------------------------------------------
      // `buyReward` — IP ile ödül alma (CLAUDE.md Bölüm 7.2).
      //
      // Kupon kullanıcının kendi cihazından basılıyor (Blaze kapalı,
      // docs/DECISIONS.md §10) ama tek bir alanı bile serbest değil:
      //   · değer, tür, süre, IP fiyatı → ŞABLONDAN kopyalanmak zorunda
      //   · şablon aktif olmalı
      //   · aynı commit'te bütçe sayacı ve aylık sayaç artmalı
      //   · aynı commit'te kullanıcının IP'si tam `costIp` kadar düşmeli
      // Yani "kendime bedava 500 € kupon basayım" mümkün değil.
      // -----------------------------------------------------------------
      // Bu üçlü şart olmadan kupon basmak BEDAVA olurdu: kullanıcı kuponu
      // yazar, bütçeye ve kendi puanına hiç dokunmazdı. Testler bu açığı
      // yakaladı (tests/rewards.rules.test.ts "IP düşmeden kupon basılamaz").
      function templatePath() {
        return /databases/$(database)/documents/rewardTemplates/$(request.resource.data.templateId);
      }

      function budgetCommitted() {
        return getAfter(templatePath()).data.spentCents
                 == get(templatePath()).data.spentCents + request.resource.data.valueCents
               && getAfter(templatePath()).data.issuedCount
                 == get(templatePath()).data.issuedCount + 1;
      }

      function ipPaid() {
        // Bedava ödüllerde (costIp == 0) düşülecek puan yok.
        return request.resource.data.costIp == 0
               || getAfter(/databases/$(database)/documents/users/$(uid())).data.stats.ip
                    == get(/databases/$(database)/documents/users/$(uid())).data.stats.ip
                       - request.resource.data.costIp;
      }

      allow create: if verified()
                    && request.resource.data.uid == uid()
                    && budgetCommitted()
                    && ipPaid()
                    && template().active == true
                    && request.resource.data.orgId == template().orgId
                    && request.resource.data.kind == template().kind
                    && request.resource.data.valueCents == template().valueCents
                    && request.resource.data.discountPercent == template().discountPercent
                    && request.resource.data.costIp == template().costIp
                    && request.resource.data.status == 'issued'
                    && request.resource.data.redeemedAt == null
                    && request.resource.data.redeemedBy == null
                    && request.resource.data.issuedAt == request.time
                    // Geçerlilik süresi şablondaki günden uzun olamaz.
                    && request.resource.data.expiresAt
                         <= request.time + duration.value(template().validityDays, 'd')
                    && request.resource.data.expiresAt > request.time
                    && !('seed' in request.resource.data);

      // -----------------------------------------------------------------
      // `redeemVoucher` — vezne/partner kullanıldı işaretler (Bölüm 7.4).
      //
      // Dört kontrol: imza (okunamayan token belgesi), süre, durum, kurum
      // yetkisi. Kupon `issued` değilse ikinci kullanım imkânsız.
      // -----------------------------------------------------------------
      function liveToken() {
        return get(/databases/$(database)/documents/vouchers/$(voucherId)/qr/current).data;
      }

      function tokenPath() {
        return /databases/$(database)/documents/vouchers/$(voucherId)/qr/current;
      }

      allow update: if canRedeem(resource.data)
                    && onlyFields(['status', 'redeemedAt', 'redeemedBy',
                                   'redemptionOrgId', 'presentedNonce'])
                    && resource.data.status == 'issued'
                    && request.resource.data.status == 'redeemed'
                    && request.resource.data.redeemedBy == uid()
                    && request.resource.data.redeemedAt == request.time
                    && request.time < resource.data.expiresAt
                    && exists(tokenPath())
                    && request.resource.data.presentedNonce == liveToken().nonce
                    && request.time < liveToken().expiresAt;

      // `revokeVoucher` — kurum yöneticisi iptal eder.
      allow update: if orgAdmin(resource.data.orgId)
                    && onlyFields(['status'])
                    && resource.data.status == 'issued'
                    && request.resource.data.status == 'revoked';

      // `expireVouchers` — süresi geçmişi işaretleme. Yalnız gerçekten
      // geçmişse; "süresi doldu" diyerek kuponu erken öldürmek yasak.
      allow update: if orgAdmin(resource.data.orgId)
                    && onlyFields(['status'])
                    && resource.data.status == 'issued'
                    && request.resource.data.status == 'expired'
                    && request.time > resource.data.expiresAt;

      // HESAP SİLME — kimlik eşleştirme alanlarını sil (Faz 7, DECISIONS §13)
      //
      // `holderName`/`holderPhotoURL` vezne ekranı için kopyalanmıştı
      // (Bölüm 7.4). Kupon belgesi finansal kayıt olduğu için KALIR
      // (ledger'daki gibi — Bölüm 10: "anonimleştirilir, silinmez"), ama bu
      // iki kimlik alanı durumdan BAĞIMSIZ, boşa çevrilebilir. Tutar,
      // tarih, durum gibi muhasebe alanlarına dokunulamaz.
      allow update: if signedIn()
                    && resource.data.uid == uid()
                    && onlyFields(['holderName', 'holderPhotoURL'])
                    && request.resource.data.holderName == ''
                    && request.resource.data.holderPhotoURL == null;

      // Kupon SİLİNMEZ: defterin karşılığı bu belge.
      allow delete: if false;

      // -----------------------------------------------------------------
      // 60 saniyelik gösterim token'ı (CLAUDE.md Bölüm 7.4).
      //
      // 🔒 HİÇBİR istemciye OKUNMAZ — vezne bile. Vezne taradığı nonce'u
      // yazıyor, karşılaştırmayı kural yapıyor.
      //
      // Kupon sahibi yazabiliyor ama `expiresAt == request.time + 60 sn`
      // şartı yüzünden uzun ömürlü token üretemiyor. Ekran görüntüsü 60
      // saniye sonra ölü.
      // -----------------------------------------------------------------
      match /qr/{tokenId} {
        function voucher() {
          return get(/databases/$(database)/documents/vouchers/$(voucherId)).data;
        }

        allow read: if false;
        allow write: if signedIn()
                     && voucher().uid == uid()
                     && voucher().status == 'issued'
                     && request.resource.data.nonce is string
                     && request.resource.data.nonce.size() >= 16
                     // Ömür ARALIKLA sınırlanıyor, eşitlikle değil: istemci
                     // saati ile sunucu saati arasındaki gecikme/kayma
                     // yüzünden tam eşitlik hiçbir zaman tutmazdı. Üst sınır
                     // 90 sn — 60 sn hedefi + makul kayma payı. Uzun ömürlü
                     // token üretip ekran görüntüsü paylaşmak yine imkânsız.
                     && request.resource.data.expiresAt > request.time
                     && request.resource.data.expiresAt
                          <= request.time + duration.value(90, 's');
      }
    }

    // ---------------------------------------------------------------------
    // ledger — DEĞİŞMEZ muhasebe defteri  💶
    // ---------------------------------------------------------------------
    match /ledger/{txId} {
      // Yalnızca EKLEME. Silme/güncelleme hiçbir koşulda yok (Bölüm 7.3) —
      // tutarlılık scripti defterden bakiye yeniden hesaplayabilmeli.
      allow get, list: if signedIn() && (resource.data.uid == uid()
                                         || orgAdmin(resource.data.get('orgId', ''))
                                         || isAdmin());

      // `ip_award` — katılım puanı. Tutar pasaport girdisiyle BİREBİR aynı.
      function refEntry() {
        return getAfter(/databases/$(database)/documents/passportEntries/$(request.resource.data.refId)).data;
      }

      allow create: if request.resource.data.type == 'ip_award'
                    && request.resource.data.currency == 'IP'
                    && request.resource.data.actorUid == uid()
                    && orgStaff(request.resource.data.orgId)
                    && refEntry().uid == request.resource.data.uid
                    && refEntry().orgId == request.resource.data.orgId
                    && refEntry().ipAwarded == request.resource.data.amount;

      // Kupon hareketleri — tutar aynı commit'teki kuponla eşleşmek zorunda.
      function refVoucher() {
        return getAfter(/databases/$(database)/documents/vouchers/$(request.resource.data.refId)).data;
      }

      // `ip_spend` — ödül mağazasından alım. Tutar NEGATİF (harcama).
      allow create: if request.resource.data.type == 'ip_spend'
                    && request.resource.data.currency == 'IP'
                    && request.resource.data.uid == uid()
                    && request.resource.data.actorUid == uid()
                    && refVoucher().uid == uid()
                    && request.resource.data.amount == -refVoucher().costIp;

      // `voucher_issue` — kurumun bütçesinden çıkan değer.
      allow create: if request.resource.data.type == 'voucher_issue'
                    && request.resource.data.currency == 'EUR'
                    && request.resource.data.uid == uid()
                    && refVoucher().uid == uid()
                    && request.resource.data.amount == refVoucher().valueCents
                    && request.resource.data.orgId == refVoucher().orgId;

      // `voucher_redeem` — vezne ödedi. Yazan taraf vezne/partner.
      allow create: if request.resource.data.type == 'voucher_redeem'
                    && request.resource.data.currency == 'EUR'
                    && request.resource.data.actorUid == uid()
                    && refVoucher().status == 'redeemed'
                    && refVoucher().redeemedBy == uid()
                    && request.resource.data.uid == refVoucher().uid
                    && request.resource.data.amount == -refVoucher().valueCents;

      // `voucher_revoke` — kurum iptal etti.
      allow create: if request.resource.data.type == 'voucher_revoke'
                    && request.resource.data.actorUid == uid()
                    && orgAdmin(request.resource.data.orgId)
                    && refVoucher().status == 'revoked';

      // 🔒 Bölüm 7.3: defter DEĞİŞMEZ.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // trainerApplications — eğitmen başvuruları
    // ---------------------------------------------------------------------
    match /trainerApplications/{userId} {
      // Belge dil belgesini (data URL) taşıyor — yalnız sahibi ve admin.
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();

      // -----------------------------------------------------------------
      // BAŞVURU — kullanıcı kendi adına, her zaman 'pending' (Bölüm 8).
      //
      // Kimlik = uid, yani bir kişi bir başvuru; ikinci kez göndermek
      // öncekinin üstüne yazar ve yine 'pending' olur.
      //
      // 🔒 Kimse kendi başvurusunu ONAYLAYAMAZ: `status` yalnız 'pending'
      // olabiliyor ve `reviewedBy` null olmak zorunda.
      // -----------------------------------------------------------------
      allow create, update: if isSelf(userId)
                            && verified()
                            && request.resource.data.uid == userId
                            && request.resource.data.status == 'pending'
                            && request.resource.data.reviewedBy == null
                            && request.resource.data.submittedAt == request.time
                            && request.resource.data.motivation is string
                            && request.resource.data.motivation.size() <= 1000
                            && request.resource.data.certificateDataUrl is string
                            && request.resource.data.certificateDataUrl.size() <= 500000;

      // İNCELEME — yalnız platform admin.
      allow update: if isAdmin()
                    && onlyFields(['status', 'reviewedBy', 'reviewedAt', 'note'])
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['approved', 'rejected']
                    && request.resource.data.reviewedBy == uid();

      // Hesap silme (Faz 7, docs/DECISIONS.md §13): başvuru metni ve
      // dil belgesi kişisel içerik taşıyor, kendi başvurusunu silebilir.
      // `trainerStatus` zaten `users/{uid}`de tutuluyor, bu belgenin
      // varlığına bağlı değil — silinmesi trainer yetkisini etkilemez.
      allow delete: if isSelf(userId);
    }

    // ---------------------------------------------------------------------
    // İçerik: duyurular, slider, sertifikalar
    // ---------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow get, list: if signedIn();

      // Duyuruyu kurum personeli ya da platform admin yazar (Bölüm 12).
      //
      // 🔒 `pushSent` bayrağına istemci DOKUNAMAZ: push'u yalnız sunucu
      // gönderebilir ve "gönderildi" demek, gönderilmediği hâlde ikinci bir
      // denemeyi engellemek olurdu.
      function announcementShapeOk() {
        return request.resource.data.createdBy == uid()
               && request.resource.data.pushSent == false
               && request.resource.data.createdAt == request.time
               && request.resource.data.title.de.size() <= 120
               && request.resource.data.title.en.size() <= 120
               && request.resource.data.body.de.size() <= 1200
               && request.resource.data.body.en.size() <= 1200;
      }

      allow create: if announcementShapeOk()
                    && (
                         (request.resource.data.orgId != ''
                          && orgStaff(request.resource.data.orgId))
                      || (request.resource.data.orgId == '' && isAdmin())
                    );

      allow update: if onlyFields(['title', 'body', 'pinned', 'linkActivityId',
                                   'imageURL', 'expiresAt'])
                    && (orgStaff(resource.data.orgId) || isAdmin());

      allow delete: if orgStaff(resource.data.get('orgId', '')) || isAdmin();
    }

    match /slider/{slideId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    match /certificates/{certificateId} {
      allow get: if signedIn() && (resource.data.uid == uid() || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // feedback — kullanıcı geri bildirimi
    // ---------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow get, list: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // auditLog — denetim kaydı
    // ---------------------------------------------------------------------
    match /auditLog/{entryId} {
      allow get, list: if isAdmin();

      // CLAUDE.md Bölüm 7.5: "tüm manuel onaylar auditLog'a."
      // Sunucu olmadığı için kaydı işlemi yapan cihaz yazıyor. Yalnız
      // EKLEME ve yalnız kendi adına; değiştirilemez, silinemez.
      allow create: if signedIn()
                    && request.resource.data.actorUid == uid()
                    && request.resource.data.action is string
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // config — puan kuralları vb.
    // ---------------------------------------------------------------------
    match /config/{docId} {
      allow get, list: if signedIn();
      // Puan kuralları editörü (Bölüm 9). Sürüm numarası ZORUNLU ve her
      // kayıtta artmalı: hangi kuralın ne zaman geçerli olduğu geriye dönük
      // anlaşılabilsin.
      allow create: if isAdmin() && request.resource.data.version is int;
      allow update: if isAdmin()
                    && request.resource.data.version is int
                    && request.resource.data.version > resource.data.get('version', 0);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // verifications — PDF Integrationspass doğrulama sayfası (Faz 7)
    //
    // CLAUDE.md Bölüm 1A: "PDF pasaport: doğrulama adresi
    // https://ehrenweg.de/verify/{id}". O sayfa OTURUMSUZ açılır (bir
    // işveren uygulamayı hiç kullanmıyor olabilir) — bu yüzden `get`
    // herkese açık. `list` KAPALI: belge kimliği istemcide üretilen 128
    // bit'lik rastgele bir token, tahmin edilemez; birisi yalnız elindeki
    // bağlantıyla belgeye ulaşabilir, kimse koleksiyonu tarayamaz.
    //
    // Belge içeriği PDF'in TAMAMI değil, özeti: ad, seviye, toplam saat,
    // katılım sayısı, çıkarılma tarihi. Beceri listesi, katılım geçmişi ve
    // fotoğraf yalnız PDF'in kendisinde kalır (Bölüm 9: "kişisel veriyi en
    // az düzeyde tutsun").
    //
    // Sahtecilik engeli: değerler client'ın uydurduğu sayılar DEĞİL,
    // `get()` ile kullanıcının GERÇEK `users/{uid}.stats`'ına eşit olmak
    // zorunda — tıpkı diğer tüm "Blaze kapalı" sapmalarında olduğu gibi.
    // ---------------------------------------------------------------------
    match /verifications/{token} {
      allow get: if true;
      allow list: if false;

      function myStats() {
        return get(/databases/$(database)/documents/users/$(uid())).data.stats;
      }

      allow create: if signedIn()
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 80
                    && request.resource.data.locale in ['de', 'en']
                    && request.resource.data.level == myStats().level
                    && request.resource.data.hours == myStats().hours
                    && request.resource.data.activitiesCompleted
                         == myStats().activitiesCompleted
                    && request.resource.data.issuedAt == request.time;

      // Belge bir anlık görüntü (snapshot): yeniden indirme yeni bir token
      // üretir, eskisi geçmişte doğru olduğunu göstermeye devam eder.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Yukarıda açıkça izin verilmeyen HER ŞEY kapalı.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
