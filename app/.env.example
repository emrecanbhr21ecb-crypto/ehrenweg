# Ehrenweg — ortam değişkeni ŞABLONU
#
# Bu dosya git'e girer (değer YOK, sadece anahtar isimleri).
# Gerçek değerler .env.development / .env.production içine yazılır ve
# .gitignore tarafından engellenir.
#
# Değerleri şöyle alırsın:
#   firebase apps:list --project ehrenweg-dev
#   firebase apps:sdkconfig web <APP_ID> --project ehrenweg-dev
#
# NOT: VITE_ ile başlayan her değer tarayıcı paketine GÖMÜLÜR ve herkese
# görünür. Buraya ASLA gerçek sır koyma (Anthropic API anahtarı, HMAC sırrı,
# servis hesabı vb.). Onlar Cloud Functions + Secret Manager tarafında durur.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — reCAPTCHA Enterprise site key (web). Emülatörde gerekmez.
VITE_RECAPTCHA_SITE_KEY=

# Emülatör kullan? Boş bırakılırsa: geliştirmede true, üretim derlemesinde false.
VITE_USE_EMULATORS=true

# Telefondan test ederken bilgisayarın LAN IP'si (ör. 192.168.1.42).
# Boş bırakılırsa 127.0.0.1 kullanılır.
VITE_EMULATOR_HOST=
