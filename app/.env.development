# Ehrenweg — GELİŞTİRME (emülatör) yapılandırması
#
# ⚠️ BU DOSYA GIT'E GİRER. Buraya ASLA gerçek anahtar yazma.
#
# Buradaki değerler sahtedir ve yalnızca Firebase Emulator Suite'i hedefler.
# Proje kimliğinin 'demo-' ile başlaması Firebase SDK'sının üretim sunucularına
# ASLA bağlanmamasını garanti eder — yanlışlıkla canlı veriye dokunma riski yok.
#
# Gerçek dev projesine (ehrenweg-dev) bağlanmak istersen:
#   1. app/.env.development.local dosyası oluştur (git dışında)
#   2. 'firebase apps:sdkconfig web <APP_ID> --project ehrenweg-dev' çıktısını yaz
#   3. VITE_USE_EMULATORS=false ekle
# Vite .local dosyasını bunun ÜZERİNE yükler.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ehrenweg.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ehrenweg
VITE_FIREBASE_STORAGE_BUCKET=demo-ehrenweg.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_USE_EMULATORS=true
